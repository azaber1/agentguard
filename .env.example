# Copy to .env and fill in. Never commit .env.

# Database password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Encrypts agent endpoint tokens at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes stored tokens unreadable.
SECRET_KEY=

# development | production. Production enables Secure cookies, HSTS, disables
# the OpenAPI docs and refuses to start with a default SECRET_KEY.
ENVIRONMENT=development

# Set false for public deployments; create accounts another way.
ALLOW_REGISTRATION=true

# Secure cookies default to on in production. Only set false for plain-HTTP local use.
COOKIE_SECURE=false

# Allow agent endpoints on private/loopback networks (local development only).
ALLOW_PRIVATE_AGENT_URLS=false

# Seed the demo organization, agents and runs on startup (local demos only).
SEED_DEMO_DATA=true
DEMO_PASSWORD=AgentGuard-demo-2026

FRONTEND_PORT=3000
